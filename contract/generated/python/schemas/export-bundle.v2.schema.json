{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gyrox.dev/schemas/export-bundle/v2",
  "title": "Export bundle manifest v2",
  "$comment": "ADR-006 D8-2: export-time snapshot; source and scope are historical claims. Unspecified exportedAt/orgId/runId formats and artifact kind vocabulary remain unconstrained strings. specHashes uses the four run-manifest spec slots. Hashes inherit the v1 SHA-256 representation.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "exportedAt": {
      "type": "string"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "recipe": {
      "$ref": "#/$defs/ref"
    },
    "source": {
      "type": "object",
      "properties": {
        "orgId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "manifestHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "documentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "specHashes": {
          "type": "object",
          "properties": {
            "geometry": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "discretization": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "solve": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "post": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "geometry",
            "discretization",
            "solve",
            "post"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "orgId",
        "runId",
        "manifestHash",
        "documentSha256",
        "specHashes"
      ],
      "additionalProperties": false
    },
    "specs": {
      "type": "object",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/external0"
        },
        "discretization": {
          "$ref": "#/$defs/external1"
        },
        "solve": {
          "$ref": "#/$defs/external2"
        },
        "post": {
          "$ref": "#/$defs/external3"
        }
      },
      "required": [
        "geometry",
        "discretization",
        "solve",
        "post"
      ],
      "additionalProperties": false
    },
    "document": {
      "$ref": "#/$defs/external4"
    },
    "summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/external5"
        },
        {
          "type": "null"
        }
      ]
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "noticeId": {
            "enum": [
              "D8-2",
              "dp-hot-fixture-limited",
              "dp-cold-not-established",
              "nonconverged-partial",
              "governance-hold",
              "dp-hot-out-of-scope",
              "export-snapshot"
            ]
          },
          "ko": {
            "type": "string"
          },
          "en": {
            "type": "string"
          }
        },
        "required": [
          "noticeId",
          "ko",
          "en"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true,
      "contains": {
        "type": "object",
        "properties": {
          "noticeId": {
            "const": "export-snapshot"
          }
        },
        "required": [
          "noticeId"
        ]
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "noticeId": {
                "const": "D8-2"
              }
            },
            "required": [
              "noticeId"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "noticeId": {
                "const": "dp-hot-fixture-limited"
              }
            },
            "required": [
              "noticeId"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "noticeId": {
                "const": "dp-cold-not-established"
              }
            },
            "required": [
              "noticeId"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "noticeId": {
                "const": "nonconverged-partial"
              }
            },
            "required": [
              "noticeId"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "noticeId": {
                "const": "governance-hold"
              }
            },
            "required": [
              "noticeId"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "noticeId": {
                "const": "dp-hot-out-of-scope"
              }
            },
            "required": [
              "noticeId"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "noticeId": {
                "const": "export-snapshot"
              }
            },
            "required": [
              "noticeId"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "$ref": "#/$defs/external6/properties/files/items/properties/path"
          },
          "mediaType": {
            "$ref": "#/$defs/external6/properties/files/items/properties/mediaType"
          },
          "meta": {
            "type": "object",
            "properties": {
              "units": {
                "$ref": "#/$defs/external6/properties/files/items/properties/units"
              },
              "coordinateSystem": {
                "$ref": "#/$defs/external6/properties/files/items/properties/coordinateSystem"
              },
              "semanticRole": {
                "$ref": "#/$defs/external6/properties/files/items/properties/semanticRole"
              }
            },
            "required": [],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "type": "object",
                  "anyOf": [
                    {
                      "required": [
                        "units"
                      ]
                    },
                    {
                      "required": [
                        "coordinateSystem"
                      ]
                    }
                  ]
                },
                "then": {
                  "required": [
                    "units",
                    "coordinateSystem"
                  ]
                }
              }
            ],
            "$comment": "Metadata fields transcribed from output-manifest.v1; mediaType is the sibling artifact field. Output-manifest bytes/sha256/path/kind are file identity, not metadata."
          },
          "derivedFrom": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "kind",
          "hash",
          "path",
          "mediaType",
          "meta"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "field",
                    "slice",
                    "volume",
                    "wall-field",
                    "wall-mesh"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "meta": {
                  "type": "object",
                  "required": [
                    "units",
                    "coordinateSystem"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "absentKinds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "properties": {
        "isFixtureCase": {
          "type": "boolean"
        },
        "anchorsRevision": {
          "type": "integer",
          "$comment": "Revision number transcribed from infra/governance/anchors.json; no new range constraint."
        }
      },
      "required": [
        "isFixtureCase",
        "anchorsRevision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "exportedAt",
    "revision",
    "recipe",
    "source",
    "specs",
    "document",
    "summary",
    "notices",
    "artifacts",
    "absentKinds",
    "scope"
  ],
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "hash"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "external0": {
      "title": "GeometrySpec v1 canonical envelope",
      "type": "object",
      "required": [
        "kind",
        "schemaVersion",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "geometry-spec"
        },
        "schemaVersion": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "required": [
            "pattern",
            "cellSizeM",
            "wallThicknessM",
            "splitting",
            "envelope",
            "ports"
          ],
          "properties": {
            "pattern": {
              "const": "gyroid"
            },
            "cellSizeM": {
              "type": "object",
              "required": [
                "kind",
                "valueM"
              ],
              "properties": {
                "kind": {
                  "const": "const"
                },
                "valueM": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "wallThicknessM": {
              "type": "object",
              "required": [
                "kind",
                "valueM"
              ],
              "properties": {
                "kind": {
                  "const": "const"
                },
                "valueM": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "splitting": {
              "const": "fullwall"
            },
            "envelope": {
              "type": "object",
              "required": [
                "kind",
                "sizeM"
              ],
              "properties": {
                "kind": {
                  "const": "box"
                },
                "sizeM": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "additionalProperties": false
            },
            "ports": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "const": "hot-inlet"
                      },
                      "domain": {
                        "const": "hot"
                      },
                      "face": {
                        "enum": [
                          "-x",
                          "+x",
                          "-y",
                          "+y",
                          "-z",
                          "+z"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "domain",
                      "face"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "const": "hot-outlet"
                      },
                      "domain": {
                        "const": "hot"
                      },
                      "face": {
                        "enum": [
                          "-x",
                          "+x",
                          "-y",
                          "+y",
                          "-z",
                          "+z"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "domain",
                      "face"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "const": "cold-inlet"
                      },
                      "domain": {
                        "const": "cold"
                      },
                      "face": {
                        "enum": [
                          "-x",
                          "+x",
                          "-y",
                          "+y",
                          "-z",
                          "+z"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "domain",
                      "face"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "const": "cold-outlet"
                      },
                      "domain": {
                        "const": "cold"
                      },
                      "face": {
                        "enum": [
                          "-x",
                          "+x",
                          "-y",
                          "+y",
                          "-z",
                          "+z"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "domain",
                      "face"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "minItems": 4,
              "maxItems": 4,
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "const": "hot-inlet"
                      }
                    },
                    "required": [
                      "id"
                    ]
                  }
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "const": "hot-outlet"
                      }
                    },
                    "required": [
                      "id"
                    ]
                  }
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "const": "cold-inlet"
                      }
                    },
                    "required": [
                      "id"
                    ]
                  }
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "const": "cold-outlet"
                      }
                    },
                    "required": [
                      "id"
                    ]
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "external1": {
      "title": "DiscretizationSpec v1 canonical envelope",
      "type": "object",
      "required": [
        "kind",
        "schemaVersion",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "discretization-spec"
        },
        "schemaVersion": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "required": [
            "route",
            "voxelPitchM",
            "qa"
          ],
          "properties": {
            "route": {
              "const": "voxel-hexa"
            },
            "voxelPitchM": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "qa": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxNonOrtho": {
                  "const": 65
                },
                "maxBoundarySkewness": {
                  "const": 20
                },
                "maxInternalSkewness": {
                  "const": 4
                },
                "maxConcave": {
                  "const": 80
                },
                "minVol": {
                  "const": 1e-18
                },
                "minTetQuality": {
                  "const": 1e-15
                },
                "minArea": {
                  "const": -1
                },
                "minTwist": {
                  "const": 0.02
                },
                "minDeterminant": {
                  "const": 0.001
                },
                "minFaceWeight": {
                  "const": 0.05
                },
                "minVolRatio": {
                  "const": 0.01
                },
                "minTriangleTwist": {
                  "const": -1
                },
                "minEdgeLength": {
                  "const": -1
                }
              },
              "required": [
                "maxNonOrtho",
                "maxBoundarySkewness",
                "maxInternalSkewness",
                "maxConcave",
                "minVol",
                "minTetQuality",
                "minArea",
                "minTwist",
                "minDeterminant",
                "minFaceWeight",
                "minVolRatio",
                "minTriangleTwist",
                "minEdgeLength"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "external2": {
      "title": "SolveSpec v1 canonical envelope",
      "$comment": "ADR-006 D8-2",
      "$defs": {
        "PresetRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalogId",
            "version"
          ],
          "properties": {
            "catalogId": {
              "enum": [
                "water-60c",
                "water-20c",
                "aluminum",
                "cht-simple-v1"
              ]
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "FluidProps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rhoKgM3",
            "cpJKgK",
            "muPaS",
            "prandtl"
          ],
          "properties": {
            "rhoKgM3": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cpJKgK": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "muPaS": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "prandtl": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "SolidProps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rhoKgM3",
            "cpJKgK",
            "kWMK"
          ],
          "properties": {
            "rhoKgM3": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cpJKgK": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "kWMK": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "NumericsBody": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "energyCouplingIters",
            "hTol",
            "writePrecision",
            "relaxation"
          ],
          "properties": {
            "energyCouplingIters": {
              "const": 25
            },
            "hTol": {
              "const": 0.000001
            },
            "writePrecision": {
              "const": 10
            },
            "relaxation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fluid",
                "solid"
              ],
              "properties": {
                "fluid": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rho",
                    "pRgh",
                    "U",
                    "h"
                  ],
                  "properties": {
                    "rho": {
                      "const": 1
                    },
                    "pRgh": {
                      "const": 0.7
                    },
                    "U": {
                      "const": 0.3
                    },
                    "h": {
                      "const": 0.5
                    }
                  }
                },
                "solid": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "h"
                  ],
                  "properties": {
                    "h": {
                      "const": 0.7
                    }
                  }
                }
              }
            }
          }
        }
      },
      "type": "object",
      "required": [
        "kind",
        "schemaVersion",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "solve-spec"
        },
        "schemaVersion": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend",
            "solver",
            "materials",
            "bc",
            "numerics",
            "convergence",
            "limits"
          ],
          "properties": {
            "backend": {
              "const": "openfoam-cht"
            },
            "solver": {
              "const": "chtMultiRegionSimpleFoam"
            },
            "materials": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hot",
                "cold",
                "solid"
              ],
              "properties": {
                "hot": {
                  "$ref": "#/$defs/external2/$defs/FluidProps"
                },
                "cold": {
                  "$ref": "#/$defs/external2/$defs/FluidProps"
                },
                "solid": {
                  "$ref": "#/$defs/external2/$defs/SolidProps"
                }
              }
            },
            "bc": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "featureRef",
                    "kind",
                    "mdotKgS",
                    "tK"
                  ],
                  "properties": {
                    "featureRef": {
                      "const": "port:hot-inlet"
                    },
                    "kind": {
                      "const": "flowRateInlet"
                    },
                    "mdotKgS": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "tK": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "featureRef",
                    "kind",
                    "mdotKgS",
                    "tK"
                  ],
                  "properties": {
                    "featureRef": {
                      "const": "port:cold-inlet"
                    },
                    "kind": {
                      "const": "flowRateInlet"
                    },
                    "mdotKgS": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "tK": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "numerics": {
              "$ref": "#/$defs/external2/$defs/NumericsBody"
            },
            "convergence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "windowIters": {
                  "const": 200
                },
                "windowMeanDriftPct": {
                  "const": 0.5
                },
                "windowMeanSpanPct": {
                  "const": 0.5
                },
                "windowMeanTailW": {
                  "const": 200
                },
                "transientFrac": {
                  "const": 0.2
                },
                "windowMeanMinIters": {
                  "const": 500
                },
                "instSpanPct": {
                  "const": 0.5
                },
                "judgedQoI": {
                  "const": [
                    "dpHotPa",
                    "dpColdPa",
                    "qW"
                  ]
                },
                "tOutDriftK": {
                  "const": 0.1
                },
                "tOutSpanK": {
                  "const": 0.1
                },
                "ebMaxPct": {
                  "const": 1
                },
                "ebWarnPct": {
                  "const": 0.7
                },
                "massImbalanceMaxPct": {
                  "const": 0.1
                },
                "signSanity": {
                  "const": true
                },
                "finiteRequired": {
                  "const": true
                },
                "signRules": {
                  "const": {
                    "flowDirection": {
                      "hot": {
                        "inlet": "negative",
                        "outlet": "positive"
                      },
                      "cold": {
                        "inlet": "negative",
                        "outlet": "positive"
                      }
                    },
                    "pressureDirection": {
                      "dpHotPa": "positive",
                      "dpColdPa": "positive"
                    },
                    "wallHeatFluxDirection": {
                      "hot": "negative",
                      "cold": "positive"
                    }
                  }
                },
                "minIterationsForJudgment": {
                  "const": 400
                },
