{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gyrox.dev/schemas/project-document/v1",
  "title": "ProjectDocument v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "nodes",
    "rootId"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "rootId": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "type",
        "parentId",
        "params",
        "meta"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "parentId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "params": {
          "$ref": "#/$defs/jsonObject"
        },
        "meta": {
          "$ref": "#/$defs/jsonObject"
        }
      },
      "additionalProperties": false
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "not": {
            "pattern": "^[dD][aA][tT][aA]:"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "$ref": "#/$defs/jsonObject"
        }
      ]
    }
  }
}
