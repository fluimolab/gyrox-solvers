{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gyrox.dev/schemas/post-spec/v1",
  "title": "PostSpec v1 canonical envelope",
  "$comment": "ADR-006 D8-2",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "payload"
  ],
  "properties": {
    "kind": {
      "const": "post-spec"
    },
    "schemaVersion": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "properties": {
        "tier1": {
          "const": {
            "summary": true,
            "timeseries": true
          }
        },
        "tier2": {
          "const": {
            "slices": [
              {
                "axis": "z",
                "offsetM": 0.015,
                "fields": [
                  "p",
                  "T"
                ]
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "tier1",
        "tier2"
      ]
    }
  },
  "additionalProperties": false
}
