{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gyrox.dev/schemas/resource-estimate/v1",
  "title": "ResourceEstimate v1",
  "type": "object",
  "required": [
    "cells",
    "ram",
    "disk",
    "wallClock",
    "bucket",
    "feasible",
    "warnings"
  ],
  "properties": {
    "cells": {
      "type": "number",
      "minimum": 0
    },
    "ram": {
      "$ref": "#/$defs/range"
    },
    "disk": {
      "$ref": "#/$defs/range"
    },
    "wallClock": {
      "$ref": "#/$defs/range"
    },
    "bucket": {
      "enum": [
        "small",
        "medium",
        "large"
      ]
    },
    "feasible": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "range": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
